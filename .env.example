# ---------------------------------------------------------------------------
# ARICT website — environment variables
# Copy to .env for local development. Never commit real values.
# On Vercel, add these under Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# PostgreSQL (Neon via Vercel Marketplace). The Neon integration sets these
# automatically. DATABASE_URL should be the *pooled* connection string.
DATABASE_URL=postgres://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require
# Optional: direct (unpooled) connection used for migrations.
DATABASE_URL_UNPOOLED=

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://arict.lk

# CLOUDINARY_API_SECRET=

# Local development only, when Cloudinary isn't configured: store uploads on disk
# in .data/uploads. Ignored on Vercel. Don't use this against the production database.
# LOCAL_UPLOADS=true

# EmailJS (Contact Us form). These are browser-safe identifiers from
# https://dashboard.emailjs.com — no private key is used.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# First Super Admin account, created/updated by `npm run db:seed`
# (or `npm run db:create-admin` for production without sample data).
SEED_ADMIN_EMAIL=admin@arict.lk
SEED_ADMIN_PASSWORD=

# Cache refresh between environments. Set REVALIDATE_SECRET to the same long
# random value locally and in Vercel. Locally, also set REVALIDATE_REMOTE_URL so
# edits made in a local admin (against the production database) refresh the
# live site's cache immediately. Do NOT set REVALIDATE_REMOTE_URL in Vercel.
REVALIDATE_SECRET=
# REVALIDATE_REMOTE_URL=https://arict.lk/api/revalidate
